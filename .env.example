# ==============================================================================
# Smart Cloud Cost Guardian (SCCG) - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust variables as needed:
#   cp .env.example .env
# ==============================================================================

# Application Meta
APP_NAME=Smart Cloud Cost Guardian
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true
API_V1_STR=/api/v1

# Database Configuration
# Default is SQLite for local zero-dependency testing.
# For PostgreSQL in production, use: postgresql://user:password@localhost:5432/sccg_db
DATABASE_URL=sqlite:///./sccg.db

# Security & Authentication
# Generate a strong 64-byte random secret for production!
JWT_SECRET=super-secret-sccg-guardian-jwt-key-2026-production-finops
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Symmetric Encryption Key (Fernet 32-byte urlsafe base64 string) for AWS credentials at rest
ENCRYPTION_KEY=k_Z516c09bTz8r-QnQo_fKq4W1R_tLp8-xZfX_4hE7w=

# AWS FinOps Engine Settings
AWS_DEFAULT_REGION=us-east-1
# When DEMO_MODE is true, mock realistic cloud spend and 20+ resources are used without live AWS billing
DEMO_MODE=true

# AI Assistant & Copilot Configuration
# Supported providers: 'gemini', 'openai', 'claude', 'offline'
LLM_PROVIDER=offline
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash

# Notification & Alerting (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=alerts@cloudcostguardian.io
SNS_TOPIC_ARN=

# CORS Allowed Origins (JSON array of strings)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:8000","http://127.0.0.1:5173"]
